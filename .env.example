# Copy to .env and fill in NVIDIA_API_KEY before starting hosted NVIDIA NIM calls.
# Keep .env out of version control; it contains credentials.
APP_PORT=8000
APP_ENV=production

# Use a hosted NVIDIA endpoint for prototyping, or point each service at a
# reachable self-hosted NIM. In Docker, use host.docker.internal for a NIM on
# the Docker host (for example: http://host.docker.internal:9000/v1).
ASR_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
ASR_MODEL=nvidia/parakeet-tdt-0.6b-v2
LLM_MODEL=meta/llama-3.3-70b-instruct
DEFAULT_LANGUAGE=en-US

# Service-specific keys override the shared key. Blank values fall back to
# NVIDIA_API_KEY. Self-hosted services without auth may leave all keys blank.
NVIDIA_API_KEY=
ASR_API_KEY=
LLM_API_KEY=

REQUEST_TIMEOUT_SECONDS=180
MAX_AUDIO_MB=25
MAX_NORMALIZED_AUDIO_MB=128
MAX_AUDIO_DURATION_SECONDS=3600
MAX_TRANSCRIPT_CHARS=50000

# Regex identifier masking is on by default. For optional English Presidio NER,
# set both USE_PRESIDIO=true and INSTALL_PRESIDIO=true, then rebuild the image.
PHI_REDACTION_ENABLED=true
USE_PRESIDIO=false
INSTALL_PRESIDIO=false
